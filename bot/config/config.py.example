TOKEN = "your-telegram-bot-token"

PANEL_API_URL = "https://your-panel-domain.example"
# Добавляем домен для ссылок подписки
SUB_DOMAIN_URL = "https://your-sub-domain.example"

ADMIN_ID = 0

PANEL_API_KEY = "your-remnawave-api-key"

# ======================================================
# Platega.io (Платежная система)
# ======================================================

# Данные из личного кабинета Platega.io
PLATEGA_MERCHANT_ID = "your-merchant-uuid"
PLATEGA_SECRET_KEY = "your-platega-secret-key"

# URL для API
PLATEGA_API_URL = "https://app.platega.io"

# URL для callback'ов (на ваш сервер)
PLATEGA_WEBHOOK_URL = "https://your-panel-domain.example/webhook/platega"

# Куда перенаправлять пользователя после оплаты
PLATEGA_SUCCESS_URL = "https://t.me/your_bot"
PLATEGA_FAILED_URL = "https://t.me/your_bot"

# Настройки веб-сервера для приема callback'ов
WEBHOOK_HOST = "0.0.0.0"  # Слушаем все интерфейсы
WEBHOOK_PORT = 8080       # Порт для веб-сервера (не конфликтует с панелью)


AGREEMENT_URL = "https://telegra.ph/your-agreement"
PRIVACY_URL = "https://telegra.ph/your-privacy-policy"
SUPPORT_URL = "https://t.me/your_support"

# ======================================================
# Белые списки (БС)
# ======================================================
# UUID Internal Squad с серверами белых списков. Бот управляет только этим сквадом
# (выдаёт, снимает при исчерпании лимита). Пусто — функция выключена.
BS_SQUAD_UUID = ""
# Лимит БС для тех, кто ещё ни разу не платил (триал), ГБ за 30 дней
BS_TRIAL_LIMIT_GB = 3
# Бонус за друга, активировавшего триал: ГБ белых списков (не сгорают, тратятся сверх лимита)
BS_REFERRAL_BONUS_GB = 7
# Как часто проверять лимиты, секунд
BS_CHECK_INTERVAL = 600

# ======================================================
# Возврат клиентов (включается в админке, по умолчанию выключено)
# ======================================================
RETENTION_GIFT_DAYS = 3            # сколько дней дарим не продлившим и закончившим триал
RETENTION_GIFT_GB = 3              # бонусные ГБ белых списков к подарку
RETENTION_GIFT_COOLDOWN_DAYS = 90  # подарок одному человеку не чаще, чем раз в N дней
RETENTION_CHECK_INTERVAL = 900     # как часто проверять, секунд

# ======================================================
# Оповещения админам о «плохишах»
# ======================================================
ABUSE_DAY_GB = 50          # аномальный трафик за сутки, ГБ (все ноды)
ABUSE_WEEK_GB = 200        # аномальный трафик за 7 дней, ГБ
ABUSE_IP_GROUP_MAX = 5     # общий IP у большего числа аккаунтов — оператор/общий Wi-Fi, не сообщаем
ABUSE_CHECK_INTERVAL = 3600
